% FPVirtual customization
% Brand colors extracted from docs/Plantilla_genérica_con_portada.dotx
% Corporate orange F3970D, body text dark gray 434343, Calibri (Carlito)
\definecolor{fpv-orange}{HTML}{F3970D}
\definecolor{fpv-darkorange}{HTML}{C77800}
\definecolor{fpv-darkgray}{HTML}{434343}
\definecolor{fpv-midgray}{HTML}{808080}
% Font: Calibri look-alike. The build replaces Eisvogel's Source Sans with
% Helvetica (helvet) for pdflatex; with xelatex/lualatex set
% mainfont: Carlito in the document YAML instead.
\addtokomafont{section}{\color{fpv-orange}}
\addtokomafont{subsection}{\color{fpv-darkgray}}
\addtokomafont{subsubsection}{\color{fpv-darkgray}}
\addtokomafont{paragraph}{\color{fpv-darkgray}}
\addtokomafont{pageheadfoot}{\color{fpv-darkgray}}
% Softer header/footer separation lines
\setkomafont{headsepline}{\color{fpv-midgray}}
\setkomafont{footsepline}{\color{fpv-midgray}}
\color{fpv-darkgray}
% Table of contents — replicates the dotx: level 1 entries orange
% (sectionentrypagenumber keeps page numbers dark gray), deeper levels
% dark gray. Sub-level TOC entries use the cloned tocline styles, whose
% entry format is patched directly (KOMA only provides font elements for
% part/chapter/section entries).
\addtokomafont{sectionentry}{\color{fpv-orange}\bfseries}
\setkomafont{sectionentrypagenumber}{\color{fpv-darkgray}\mdseries}
\makeatletter
\expandafter\def\csname scr@tso@subsection@entryformat\endcsname{\color{fpv-darkgray}}
\expandafter\def\csname scr@tso@default@entryformat\endcsname{\color{fpv-darkgray}}
\makeatother
% Scale images that are wider than the text block down to \linewidth,
% preserving aspect ratio (images smaller than \linewidth stay at native size)
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
